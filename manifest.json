{
  "manifest_version": 3,
  "name": "YouTube Chunks",
  "version": "1.2",
  "description": "Breaks YouTube courses into manageable tasks and tracks progress.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Course Chunk Master"
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}